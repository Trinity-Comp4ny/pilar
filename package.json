{
  "name": "pilar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "bash scripts/dev-local.sh",
    "seed:local": "bash scripts/seed-local.sh",
    "seed:demo": "bash scripts/seed-demo.sh",
    "seed": "npm run seed:local && npm run seed:demo",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:strict": "tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "preview": "vite preview",
    "gen:types": "scripts/supabase-target.sh types staging src/integrations/supabase/types.ts",
    "gen:types:staging": "scripts/supabase-target.sh types staging src/integrations/supabase/types.ts",
    "gen:types:prod": "scripts/supabase-target.sh types prod src/integrations/supabase/types.ts",
    "gen:types:local": "supabase gen types typescript --local > src/integrations/supabase/types.ts",
    "db:push:staging": "scripts/supabase-target.sh push staging",
    "db:push:prod": "scripts/supabase-target.sh push prod",
    "functions:deploy:staging": "scripts/supabase-target.sh deploy staging",
    "functions:deploy:prod": "scripts/supabase-target.sh deploy prod",
    "audit:ci": "npm audit --audit-level=high",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:migrations": "node scripts/check-migration-safety.mjs --base origin/staging",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "email:dev": "email dev --dir supabase/functions/_shared/emails"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@sentry/react": "^10.50.0",
    "@supabase/supabase-js": "^2.84.0",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "docxtemplater": "^3.68.4",
    "dompurify": "^3.4.2",
    "embla-carousel-react": "^8.3.0",
    "file-saver": "^2.0.5",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.2.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38",
    "pizzip": "^3.2.0",
    "posthog-js": "^1.372.8",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^17.0.6",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^4.1.3",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react-email": "^6.9.2",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.2.7",
    "vitest": "^4.1.10"
  }
}
