# Supabase
SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# Resend (email transacional)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Pilar <no-reply@pilarsoft.com.br>

# Sentry (opcional — sem DSN, monitoring roda em no-op)
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
# 0..1. Vazio cai no default 0.1. VITE_SENTRY_TRACES_RATE é aceito como nome legado
# e tem precedência, mas prefira este.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Cloudflare Turnstile (captcha da tela de login).
# ATENÇÃO: sem esta chave o login sobe SEM captcha. O app avisa no boot (vai pro
# Sentry como warning), mas não impede o deploy. Em produção, preencha.
VITE_TURNSTILE_SITE_KEY=

# PostHog (analytics de produto, opcional). Sem a key, analytics fica desligado.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Playwright E2E — NUNCA use credenciais de produção aqui.
# Use um ambiente de staging/local com usuário dedicado para testes.
# Como carregar: set -a && source .env && set +a && npx playwright test
E2E_TEST_EMAIL=admin-e2e@pilar.test
E2E_TEST_PASSWORD=SenhaDeTestE2E!
E2E_ADMIN_EMAIL=admin-e2e@pilar.test
E2E_ADMIN_PASSWORD=AdminSenhaE2E!
# Credenciais do portal cliente (deixe em branco — specs serão skipped sem elas)
E2E_PORTAL_EMAIL=
E2E_PORTAL_PASSWORD=
