#!/usr/bin/env sh
#
# set -e é essencial: sem ele, o typecheck do passo 2 falhava e o script seguia,
# e o exit code do hook era o do último comando (os testes). Resultado: de 2026-07
# até aqui, `tsc` quebrado nunca bloqueou um commit, embora o CONTRIBUTING.md
# afirmasse que bloqueava.
set -e

# 1. Scan de secrets (usa gitleaks se instalado localmente)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner || {
    echo "❌ gitleaks detectou possível segredo commitado. Revise antes de continuar."
    exit 1
  }
else
  echo "⚠️  gitleaks não instalado — \`brew install gitleaks\` pra scan local. CI cobre."
fi

# 2. Typecheck
npx tsc --noEmit --pretty --project tsconfig.app.json

# 3. Lint + format staged
npx lint-staged

# 4. Testes afetados pelos arquivos staged (rejeita commit se quebrar contrato).
# Só os relacionados (`vitest related` segue o grafo de imports), não a suíte inteira:
# a suíte tem 500+ arquivos e levava 5 min ou mais por commit. A suíte inteira roda no
# CI de todo PR, em 4 shards. supabase/functions fica de fora: é Deno, não Vitest.
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' ':(exclude)supabase/functions/**')
if [ -n "$STAGED_TS" ]; then
  # shellcheck disable=SC2086 # um path por palavra é o que o vitest espera
  npx vitest related --run --silent --passWithNoTests $STAGED_TS
fi
